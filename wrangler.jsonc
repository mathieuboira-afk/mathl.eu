{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathl-eu",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "mathl.eu", "custom_domain": true },
    { "pattern": "www.mathl.eu", "custom_domain": true }
  ]
}
